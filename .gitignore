# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
.venv/
env/
DoT_env/

# Environment files
.env
.env.*
!.env.example

# Temporary process output
nohup.out
*.pid
*.tmp
*.bak
*.swp
*~

# Ignore ordinary logs by default

