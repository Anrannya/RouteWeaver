!experiments/**/*.log
!experiments/**/*.out
!reports/**/*.log

# IDE / OS
.vscode/
.idea/
.cursor/
.DS_Store

# Models and checkpoints
*.pt
*.pth
*.ckpt
*.safetensors
checkpoints/
models/

# Archives
*.tar
*.tar.gz
*.zip
*.7z

# Ignore large datasets
Task_Datasets/*

# Keep dataset documentation
!Task_Datasets/README.md
!Task_Datasets/readme.md

# TmpRes temporary files only
**/TmpRes/*.tmp
**/TmpRes/*.bak
**/TmpRes/*.swp

